# MongoDB Connection String (Optional: stats and feedback disabled if empty)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/cover_page?retryWrites=true&w=majority

# Application Port (Default: 3000)
PORT=3000

# Puppeteer Chromium Path (Auto-detected in Docker and Windows/Mac/Linux)
# In Docker: /usr/bin/chromium
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
